--!nocheck
-- Party, round, session, and modal reducers: valid lifecycles, invalid transitions, duplicate start.

return function(describe, it, expect)
	local Shared = game:GetService("ReplicatedStorage").Shared
	local PartyReducer = require(Shared.Reducers.PartyReducer)
	local RoundReducer = require(Shared.Reducers.RoundReducer)
	local SessionReducer = require(Shared.Reducers.SessionReducer)
	local ModalReducer = require(Shared.Reducers.ModalReducer)
	local Config = require(Shared.Config)
	local cfg = Config.fromRaw(require(game:GetService("ServerStorage").SFE.SystemConfig))
	local maxParty = cfg.project.maxPartyPlayers

	describe("PartyReducer", function()
		it("runs Forming -> Ready -> Countdown -> Reserving -> Teleporting", function()
			local s = PartyReducer.create("p1", 1, "chapter1", "normal", maxParty)
			expect(s.phase).toBe("Forming")
			s = PartyReducer.evaluate(s, true)
			expect(s.phase).toBe("Ready")
			local started, err = PartyReducer.start(s, 1, 10)
			expect(err).toBeNil()
			expect(started.phase).toBe("Countdown")
			expect(PartyReducer.tick(started, 9).phase).toBe("Countdown")
			local reserving = PartyReducer.tick(started, 10)
			expect(reserving.phase).toBe("Reserving")
			local tele = PartyReducer.reservationSucceeded(reserving, { code = "r", placeKey = "chapter1" })
			expect(tele.phase).toBe("Teleporting")
			expect(tele.version).toBeGreaterThan(s.version)
		end)

		it("rejects duplicate start and non-leader start", function()
			local s = PartyReducer.evaluate(PartyReducer.create("p1", 1, "chapter1", "normal", maxParty), true)
			local started = PartyReducer.start(s, 1, 10)
			local again, err = PartyReducer.start(started, 1, 10)
			expect(again).toBeNil()
			expect(err).toBe(PartyReducer.Errors.ALREADY_STARTED)
			local _, nonLeader = PartyReducer.start(s, 2, 10)
			expect(nonLeader).toBe(PartyReducer.Errors.NOT_LEADER)
			local _, notReady = PartyReducer.start(PartyReducer.create("p2", 1, "chapter1", "normal", maxParty), 1, 10)
			expect(notReady).toBe(PartyReducer.Errors.NOT_READY)
		end)

		it("enforces the configured maximum party size and unique membership", function()
			local s = PartyReducer.create("p1", 1, "chapter1", "normal", maxParty)
			for userId = 2, maxParty do
				s = PartyReducer.join(s, userId)
			end
			expect(#s.members).toBe(maxParty)
			local _, full = PartyReducer.join(s, 99)
			expect(full).toBe(PartyReducer.Errors.FULL)
			local _, dup = PartyReducer.join(PartyReducer.create("p2", 1, "chapter1", "normal", maxParty), 1)
			expect(dup).toBe(PartyReducer.Errors.ALREADY_MEMBER)
		end)

		it("transfers leadership deterministically to the earliest remaining member", function()
			local s = PartyReducer.create("p1", 1, "chapter1", "normal", maxParty)
			s = PartyReducer.join(s, 2)
			s = PartyReducer.join(s, 3)
			s = PartyReducer.leave(s, 1)
			expect(s.leaderUserId).toBe(2)
			expect(s.members).toEqual({ 2, 3 })
			s = PartyReducer.leave(s, 2)
			s = PartyReducer.leave(s, 3)
			expect(s.phase).toBe("Closed")
		end)

		it("membership or destination change drops Ready/Countdown back to Forming", function()
			local s = PartyReducer.evaluate(PartyReducer.create("p1", 1, "chapter1", "normal", maxParty), true)
			s = PartyReducer.start(s, 1, 5)
			s = PartyReducer.join(s, 2)
			expect(s).toBeNil() -- cannot join during countdown
			local ready = PartyReducer.evaluate(PartyReducer.create("p1", 1, "chapter1", "normal", maxParty), true)
			local changed = PartyReducer.setDestination(ready, 1, "chapter1", "hard")
			expect(changed.phase).toBe("Forming")
			expect(changed.difficulty).toBe("hard")
		end)

		it("reservation and teleport failures return to Ready", function()
			local s = PartyReducer.evaluate(PartyReducer.create("p1", 1, "chapter1", "normal", maxParty), true)
			s = PartyReducer.tick(PartyReducer.start(s, 1, 0), 0)
			expect(s.phase).toBe("Reserving")
			expect(PartyReducer.reservationFailed(s).phase).toBe("Ready")
			local tele = PartyReducer.reservationSucceeded(s, { code = "c", placeKey = "chapter1" })
			expect(PartyReducer.teleportFailed(tele).phase).toBe("Ready")
		end)

		it("does not mutate the previous state and projection hides reservation codes", function()
			local s = PartyReducer.evaluate(PartyReducer.create("p1", 1, "chapter1", "normal", maxParty), true)
			local next = PartyReducer.start(s, 1, 3)
			expect(s.phase).toBe("Ready")
			expect(next.phase).toBe("Countdown")
			local tele = PartyReducer.reservationSucceeded(PartyReducer.tick(next, 3), { code = "secret", placeKey = "chapter1" })
			local projection = PartyReducer.project(tele, nil)
			expect(projection.reservation).toBeNil()
			expect(projection.members).toEqual({ 1 })
		end)
	end)

	describe("RoundReducer", function()
		local function searching()
			local s = RoundReducer.create("r1", "chapter1", "normal", cfg.configVersion, { 1, 2 })
			s = RoundReducer.bootstrapComplete(s, "node_7")
			s = RoundReducer.cutsceneFinished(s, 0)
			s = RoundReducer.beginSearching(s, 1000)
			return s
		end

		it("walks the full happy path", function()
			local s = RoundReducer.create("r1", "chapter1", "normal", cfg.configVersion, { 1, 2 })
			expect(s.phase).toBe("Bootstrapping")
			expect(RoundReducer.acceptsGameplay(s)).toBe(false)
			s = RoundReducer.bootstrapComplete(s, "node_7")
			expect(s.phase).toBe("Cutscene")
			s = RoundReducer.voteSkip(s, 1)
			expect(RoundReducer.allPresentVotedSkip(s)).toBe(false)
			s = RoundReducer.voteSkip(s, 2)
			expect(RoundReducer.allPresentVotedSkip(s)).toBe(true)
			s = RoundReducer.cutsceneFinished(s, 3)
			expect(s.phase).toBe("Countdown")
			s = RoundReducer.beginSearching(s, 5000)
			expect(RoundReducer.acceptsGameplay(s)).toBe(true)
			expect(RoundReducer.elapsedMs(s, 7250)).toBe(2250)
			s = RoundReducer.eggRevealed(s)
			expect(s.joinClosed).toBe(true)
			expect(RoundReducer.acceptsClaim(s)).toBe(true)
			expect(RoundReducer.acceptsGameplay(s)).toBe(false)
			s = RoundReducer.claim(s, 2, 9000)
			expect(s.phase).toBe("Victory")
			expect(s.victory.finderUserId).toBe(2)
			expect(s.victory.elapsedMs).toBe(4000)
			s = RoundReducer.beginCommit(s)
			s = RoundReducer.rewardsCommitted(s)
			expect(s.phase).toBe("Results")
			s = RoundReducer.beginReturn(s)
			expect(s.phase).toBe("Returning")
		end)

		it("only the first claim wins; later claims are rejected", function()
			local s = RoundReducer.eggRevealed(searching())
			local won = RoundReducer.claim(s, 1, 2000)
			local second, err = RoundReducer.claim(won, 2, 2001)
			expect(second).toBeNil()
			expect(err).toBe(RoundReducer.Errors.ALREADY_WON)
			-- 100 concurrent attempts on the same revealed state produce exactly one winner when applied serially
			local state = s
			local winners = 0
			for i = 1, 100 do
				local next = RoundReducer.claim(state, (i % 2) + 1, 3000)
				if next then
					winners += 1
					state = next
				end
			end
			expect(winners).toBe(1)
		end)

		it("rejects claims outside EggRevealed and from non-present players", function()
			local s = searching()
			local _, err = RoundReducer.claim(s, 1, 0)
			expect(err).toBe(RoundReducer.Errors.INVALID_PHASE)
			local revealed = RoundReducer.eggRevealed(s)
			local _, notMember = RoundReducer.claim(revealed, 42, 0)
			expect(notMember).toBe(RoundReducer.Errors.NOT_MEMBER)
			local absent = RoundReducer.setPresent(revealed, 1, false)
			local _, absentErr = RoundReducer.claim(absent, 1, 0)
			expect(absentErr).toBe(RoundReducer.Errors.NOT_MEMBER)
		end)

		it("join is allowed while Searching and closed once revealed", function()
			local s = searching()
			local joined = RoundReducer.join(s, 3)
			expect(joined.members).toEqual({ 1, 2, 3 })
			local revealed = RoundReducer.eggRevealed(joined)
			local _, err = RoundReducer.join(revealed, 4)
			expect(err).toBe(RoundReducer.Errors.JOIN_CLOSED)
			local _, cutsceneErr = RoundReducer.join(RoundReducer.create("r", "chapter1", "normal", 1, {}), 5)
			expect(cutsceneErr).toBe(RoundReducer.Errors.JOIN_CLOSED)
		end)

		it("egg node is immutable once set", function()
			local s = RoundReducer.create("r1", "chapter1", "normal", cfg.configVersion, { 1 })
			s = RoundReducer.bootstrapComplete(s, "node_1")
			local _, err = RoundReducer.bootstrapComplete(s, "node_2")
			expect(err).toBe(RoundReducer.Errors.INVALID_PHASE)
			expect(s.eggNodeId).toBe("node_1")
		end)

		it("projection never exposes the egg node", function()
			local s = searching()
			local p = RoundReducer.project(s, 1500)
			expect(p.eggNodeId).toBeNil()
			expect(p.elapsedMs).toBe(500)
			expect(p.phase).toBe("Searching")
		end)

		it("abandon is only valid before rewards", function()
			local s = RoundReducer.abandon(searching())
			expect(s.phase).toBe("Abandoned")
			expect(s.joinClosed).toBe(true)
			local victory = RoundReducer.claim(RoundReducer.eggRevealed(searching()), 1, 0)
			local _, err = RoundReducer.abandon(victory)
			expect(err).toBe(RoundReducer.Errors.INVALID_PHASE)
		end)

		it("present members drive party reward eligibility", function()
			local s = RoundReducer.setPresent(searching(), 2, false)
			expect(RoundReducer.presentMembers(s)).toEqual({ 1 })
		end)
	end)

	describe("SessionReducer", function()
		it("walks load -> lobby -> party -> teleport -> round -> results -> lobby -> saving", function()
			local s = SessionReducer.create(1, "tokenA")
			expect(s.phase).toBe("LoadingProfile")
			s = SessionReducer.profileLoaded(s)
			expect(s.phase).toBe("Lobby")
			s = SessionReducer.joinParty(s, "p1")
			expect(s.partyId).toBe("p1")
			s = SessionReducer.beginTeleport(s)
			s = SessionReducer.enterRound(s, "r1", "tokenB")
			expect(s.phase).toBe("Round")
			expect(s.sessionToken).toBe("tokenB")
			expect(SessionReducer.tokenMatches(s, "tokenA")).toBe(false)
			s = SessionReducer.roundCompleted(s)
			expect(s.phase).toBe("Results")
			s = SessionReducer.normalize(SessionReducer.returnToLobby(s, "tokenC"))
			expect(s.phase).toBe("Lobby")
			expect(s.roundId).toBeNil()
			expect(s.partyId).toBeNil()
			s = SessionReducer.beginSaving(s)
			expect(s.phase).toBe("Saving")
			expect(SessionReducer.canTransition(s, "Lobby")).toBe(false)
		end)

		it("load failure retries then removes without ever reaching Lobby", function()
			local s = SessionReducer.create(1, "t")
			s = SessionReducer.loadFailed(s)
			expect(s.phase).toBe("LoadRetry")
			expect(s.loadAttempts).toBe(1)
			s = SessionReducer.retryLoad(s)
			s = SessionReducer.loadFailed(s)
			s = SessionReducer.remove(s)
			expect(s.phase).toBe("Removed")
			expect(SessionReducer.canTransition(s, "Lobby")).toBe(false)
		end)

		it("rejects invalid transitions and double sessions", function()
			local s = SessionReducer.profileLoaded(SessionReducer.create(1, "t"))
			local _, err = SessionReducer.enterRound(s, "r1", "x")
			expect(err).toBe(SessionReducer.Errors.INVALID_PHASE)
			s = SessionReducer.joinParty(s, "p1")
			local _, dup = SessionReducer.joinParty(s, "p2")
			expect(dup).toBe(SessionReducer.Errors.ALREADY_IN_SESSION)
			local inRound = SessionReducer.enterRound(SessionReducer.beginTeleport(s), "r1", "tokenR")
			local _, otherRound = SessionReducer.enterRound(SessionReducer.disconnectInRound(inRound, 10), "r2", "z")
			expect(otherRound).toBe(SessionReducer.Errors.ALREADY_IN_SESSION)
		end)

		it("rejoin within the window restores the round, after it falls back to lobby", function()
			local s = SessionReducer.profileLoaded(SessionReducer.create(1, "t"))
			s = SessionReducer.enterRound(SessionReducer.beginTeleport(SessionReducer.joinParty(s, "p")), "r1", "tokenR")
			local reserved = SessionReducer.disconnectInRound(s, 120)
			expect(reserved.phase).toBe("RejoinReserved")
			local back = SessionReducer.rejoin(reserved, 60)
			expect(back.phase).toBe("Round")
			expect(back.roundId).toBe("r1")
			local expired = SessionReducer.normalize(SessionReducer.rejoin(reserved, 121))
			expect(expired.phase).toBe("Lobby")
			expect(expired.roundId).toBeNil()
		end)
	end)

	describe("ModalReducer", function()
		it("one blocking modal owns focus and restores the previous on close", function()
			local s = ModalReducer.create()
			s = ModalReducer.open(s, { id = "shop", priority = ModalReducer.Priority.Shop, blocking = true })
			s = ModalReducer.open(s, { id = "results", priority = ModalReducer.Priority.Results, blocking = true })
			expect(ModalReducer.top(s).id).toBe("results")
			expect(ModalReducer.isBlocking(s)).toBe(true)
			s = ModalReducer.normalize(ModalReducer.close(s, "results"))
			expect(ModalReducer.top(s).id).toBe("shop")
			expect(s.focusReturn).toBe("shop")
			s = ModalReducer.normalize(ModalReducer.close(s, "shop"))
			expect(ModalReducer.top(s)).toBeNil()
			expect(s.focusReturn).toBeNil()
			expect(ModalReducer.isBlocking(s)).toBe(false)
		end)

		it("refuses a lower-priority modal over a blocking higher one", function()
			local s = ModalReducer.create()
			s = ModalReducer.open(s, { id = "results", priority = ModalReducer.Priority.Results, blocking = true })
			local blocked, err = ModalReducer.open(s, { id = "shop", priority = ModalReducer.Priority.Shop, blocking = true })
			expect(blocked).toBeNil()
			expect(err).toBe(ModalReducer.Errors.BLOCKED)
		end)

		it("rejects duplicate open and closing something not open", function()
			local s = ModalReducer.open(ModalReducer.create(), { id = "a", priority = 5, blocking = false })
			local _, dup = ModalReducer.open(s, { id = "a", priority = 5, blocking = false })
			expect(dup).toBe(ModalReducer.Errors.ALREADY_OPEN)
			local _, missing = ModalReducer.close(s, "zzz")
			expect(missing).toBe(ModalReducer.Errors.NOT_OPEN)
			expect(ModalReducer.closeAll(s).stack).toEqual({})
		end)
	end)
end
